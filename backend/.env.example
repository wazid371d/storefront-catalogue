# Copy to .env for running the API outside Docker (npm run dev / npm start).
# docker compose up does NOT need this file — compose supplies non-secret
# local defaults directly, since nothing in local dev is actually secret
# (Fake Store API is public, Mongo/MailHog are unauthenticated local containers).

PORT=4000
NODE_ENV=development

# Mongo instance this API owns (curation, enquiries, product cache).
MONGODB_URI=mongodb://localhost:27017/storefront-catalogue

# Upstream product data source — swap this provider out, not the callers.
FAKE_STORE_API_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=900

# Email provider — points at the local MailHog catcher by default.
# Swap SMTP_HOST/PORT for your AWS SES SMTP endpoint + credentials in prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=enquiries@fieldstonegoods.test
SALES_INBOX_EMAIL=wazid371d@gmail.com

# The one browser origin allowed to call this API directly.
CORS_ORIGIN=http://localhost:3000

# Enquiry submission rate limit (the one write endpoint, the one a bot would hit).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
